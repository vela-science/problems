{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "framework": "nextjs",
  "regions": [
    "cle1"
  ],
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "cd ../.. && bun run --filter @vela/problems build",
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/hubs",
      "destination": "/problems",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/contribute",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "https://github.com/vela-science/vela/tree/main/docs",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "https://github.com/vela-science/vela/tree/main/docs",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self'"
        }
      ]
    }
  ]
}
