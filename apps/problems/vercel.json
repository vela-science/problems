{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "framework": "nextjs",
  "regions": ["cle1"],
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "cd ../.. && bun run --filter @vela/problems build",
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://www.vela.space/docs",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "https://www.vela.space/docs/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.constellate.science"
        }
      ],
      "destination": "https://problems.science/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "app.vela.space"
        }
      ],
      "destination": "https://problems.science/:path*",
      "permanent": true
    },
    {
      "source": "/review",
      "destination": "/proposals",
      "permanent": true
    },
    {
      "source": "/runs",
      "destination": "/decisions",
      "permanent": true
    },
    {
      "source": "/build-week",
      "destination": "/repositories",
      "permanent": true
    },
    {
      "source": "/frontiers",
      "destination": "/repositories",
      "permanent": true
    },
    {
      "source": "/frontiers/:path*",
      "destination": "/repositories/:path*",
      "permanent": true
    },
    {
      "source": "/repositories/erdos/:path*",
      "destination": "/repositories",
      "permanent": true
    },
    {
      "source": "/repositories/sidon-sets/:path*",
      "destination": "/repositories",
      "permanent": true
    },
    {
      "source": "/repositories/formal-conjectures/:path*",
      "destination": "/repositories",
      "permanent": true
    },
    {
      "source": "/repositories/quantum-codes/:path*",
      "destination": "/repositories",
      "permanent": true
    },
    {
      "source": "/repositories/erdos",
      "destination": "/repositories",
      "permanent": true
    },
    {
      "source": "/repositories/sidon-sets",
      "destination": "/repositories",
      "permanent": true
    },
    {
      "source": "/repositories/formal-conjectures",
      "destination": "/repositories",
      "permanent": true
    },
    {
      "source": "/repositories/quantum-codes",
      "destination": "/repositories",
      "permanent": true
    },
    {
      "source": "/repositories/:slug/findings",
      "destination": "/repositories/:slug/claims",
      "permanent": true
    },
    {
      "source": "/repositories/:slug/findings/:id*",
      "destination": "/repositories/:slug/claims/:id*",
      "permanent": true
    },
    {
      "source": "/repositories/:slug/work",
      "destination": "/repositories/:slug/contribute",
      "permanent": true
    },
    {
      "source": "/targets",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/repositories/:slug/targets",
      "destination": "/repositories/:slug/contribute",
      "permanent": true
    },
    {
      "source": "/repositories/:slug/review",
      "destination": "/repositories/:slug/proposals",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; connect-src 'self'"
        }
      ]
    }
  ]
}
