# Read-only public projection and hosted activity credentials.
VELA_PROJECTION_DATABASE_URL=
VELA_ACTIVITY_DATABASE_URL=

# WorkOS AuthKit hosted identity.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://problems.science/auth/callback
# Example only: local development uses a WorkOS staging application and the
# exact callback for the host and PORT selected when starting the app.
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:4322/auth/callback

# Public, monitored contact shown on /contact. This is not a secret.
VELA_SUPPORT_EMAIL=

# problems.science selected-repository GitHub App (server only).
GITHUB_APP_ID=
GITHUB_APP_SLUG=vela-science
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
