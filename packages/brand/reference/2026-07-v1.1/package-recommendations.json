    "workbench": ["cmdk", "sonner", "react-resizable-panels", "@dnd-kit/core", "@dnd-kit/sortable", "motion", "@floating-ui/react"],
    "graphs": ["@xyflow/react", "elkjs"],
    "editor": ["@tiptap/react", "@tiptap/starter-kit"],
    "code": ["@codemirror/state", "@codemirror/view", "shiki"],
