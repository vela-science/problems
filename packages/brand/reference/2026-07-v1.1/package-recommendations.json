  "referenceOnly": [
    "Mantine",
    "MUI",
    "Chakra UI",
    "Ant Design",
    "IBM Carbon",
    "Adobe Spectrum",
    "Microsoft Fluent",
    "GitHub Primer",
    "Shopify Polaris",
    "GOV.UK Design System",
    "US Web Design System"
  ]
}
