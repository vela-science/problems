  "adoptNow": {
    "componentModel": ["shadcn/ui registry and open-code model"],
    "primitives": ["@base-ui/react"],
    "styling": ["tailwindcss", "class-variance-authority", "clsx", "tailwind-merge"],
    "icons": ["lucide-react"],
    "data": ["@tanstack/react-query", "@tanstack/react-table", "@tanstack/react-virtual"],
    "forms": ["react-hook-form", "zod", "@hookform/resolvers"],
    "documentationAndTesting": ["storybook", "@storybook/addon-a11y", "@playwright/test", "@testing-library/react", "axe-core", "vitest"]
  },
  "adoptBySurface": {
