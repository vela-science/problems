{
  "name": "borrowed-light",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run build:diagrams && bun run generate:llms && astro build",
    "build:diagrams": "cd diagrams && ./build-diagrams.sh",
    "preview": "astro preview",
    "astro": "astro",
    "sync:essay": "bun scripts/sync-essay-from-tex.ts",
    "sync:check": "bun run sync:essay && git diff --exit-code src/components/essay",
    "generate:llms": "bun scripts/generate-llms-txt.ts"
  },
  "dependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.57.1",
    "@tailwindcss/oxide-linux-arm64-gnu": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.6",
    "lightningcss-linux-arm64-gnu": "^1.31.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5"
  }
}
