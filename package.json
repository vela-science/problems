{
  "name": "vela-web",
  "version": "0.437.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "postcss": "8.5.25",
    "esbuild": "0.28.1",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev:problems": "bun run --filter @vela/problems dev",
    "deploy:problems": "VELA_SITE_COMMIT=$(git rev-parse HEAD) bun scripts/deploy-vercel-problems.mjs",
    "release:problems": "bun scripts/release-problems.mjs",
    "lint": "bun run --filter @vela/problems lint",
    "typecheck": "bun run --filter @vela/ui typecheck && bun run --filter @vela/activity-data typecheck && bun run --filter @vela/problems typecheck",
    "check": "bun run check:release-identity && bun run check:brand && bun run check:bundle && bun run check:activity && bun run check:boundary && bun run check:tokens && bun run check:design-system && bun run typecheck",
    "check:release-identity": "bun scripts/check-release-identity.mjs",
    "check:brand": "bun run --filter @vela/brand check",
    "check:bundle": "bun run --filter @vela/projection-data check",
    "check:activity": "bun run --filter @vela/activity-data check",
    "check:boundary": "bun scripts/check-scientific-authority-boundary.mjs",
    "check:tokens": "bun scripts/check-token-references.mjs",
    "db:check": "bun run --filter @vela/projection-data db:check",
    "db:migrate": "bun run --filter @vela/projection-data db:migrate",
    "db:migrate:local": "bun run --filter @vela/projection-data db:migrate:local",
    "db:sql": "bun run --filter @vela/projection-data db:sql",
    "activity:db:migrate": "bun run --filter @vela/activity-data db:migrate",
    "activity:db:check": "bun run --filter @vela/activity-data db:check",
    "activity:db:verify": "bun run --filter @vela/activity-data db:verify",
    "activity:db:live-proof": "bun run --filter @vela/activity-data db:live-proof",
    "activity:submission:sign-local": "bun run --filter @vela/activity-data submission:sign-local --",
    "projection:reconstruct": "bun run --filter @vela/projection-data reconstruct --",
    "projection:verify": "bun run --filter @vela/projection-data verify",
    "sources:refresh": "bun run --filter @vela/projection-data sources:refresh",
    "sources:verify": "bun run --filter @vela/projection-data sources:verify",
    "test:roots": "bun run --filter @vela/projection-data test && bun run --filter @vela/activity-data test",
    "test:manifests": "bun run --filter @vela/problems test:manifest",
    "test:budgets": "bun scripts/check-budgets.mjs",
    "test:budgets:problems": "VELA_BUDGET_SCOPE=problems bun scripts/check-budgets.mjs",
    "check:design-system": "bun run --filter @vela/ui check && bun scripts/check-problems-design-system.mjs",
    "check:public-output": "bun scripts/check-public-output.mjs",
    "test": "bun test ./scripts/ && bun run --filter @vela/brand test && bun run --filter @vela/ui test && bun run --filter @vela/projection-data test && bun run --filter @vela/activity-data test && bun run --filter @vela/problems test",
    "build": "bun run --filter @vela/brand build && bun run --filter @vela/projection-data check && bun run --filter @vela/activity-data check && bun run --filter @vela/problems build && bun run check:public-output",
    "format:check": "git diff --check"
  }
}
