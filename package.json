{
  "name": "vela-web",
  "type": "module",
  "version": "0.300.1",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check:brand && pnpm check:bundle && node scripts/build-deployment-manifest.mjs && astro build && node scripts/check-public-routes.mjs",
    "check": "astro check",
    "brand:generate": "node scripts/generate-brand-css.mjs",
    "check:brand": "node scripts/generate-brand-css.mjs --check && node scripts/check-brand.mjs",
    "check:bundle": "node scripts/check-frontier-bundle.mjs",
    "check:routes": "node scripts/check-public-routes.mjs",
    "check:deployment": "node scripts/check-deployed-manifest.mjs",
    "test": "pnpm check:brand && pnpm check:bundle && node --test tests/*.test.mjs && pnpm check:routes",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "astro": "^5.16.6",
    "gsap": "^3.15.0",
    "remark-gfm": "^4.0.1",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/three": "^0.184.1",
    "typescript": "^5.9.3"
  }
}
