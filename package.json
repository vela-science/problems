{
  "name": "borrowed-light",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run build:diagrams && bun run generate:llms && astro build",
    "build:diagrams": "cd diagrams && ./build-diagrams.sh",
    "build:pdf:constellations": "bun run export:constellations:tex && cd docs/constellations && latexmk -pdf constellations.tex && cp constellations.pdf ../../public/constellations.pdf",
    "preview": "astro preview",
    "astro": "astro",
    "export:constellations:tex": "bun scripts/export-constellations-to-tex.ts",
    "sync:kernel": "bun scripts/sync-kernel-from-tex.ts",
    "sync:atlas": "bun scripts/sync-atlas-from-tex.ts",
    "sync:whitepaper": "bun scripts/sync-whitepaper-from-tex.ts",
    "generate:llms": "bun scripts/generate-llms-txt.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.6",
    "gsap": "^3.14.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5"
  }
}
